#!/bin/sh
export PATH="$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

step=5
sink="@DEFAULT_AUDIO_SINK@"

slider() {
    fill=$(($1 * 20 / 100))
    bar=""
    i=0
    while [ "$i" -lt 20 ]; do
        if [ "$i" -lt "$fill" ]; then
            bar="$bar█"
        else
            bar="$bar░"
        fi
        i=$((i + 1))
    done
    printf '%s' "$bar"
}

if ! command -v wpctl >/dev/null 2>&1; then
    notify-send -u critical 'Volume' 'wpctl not found'
    exit 1
fi

current() { wpctl get-volume "$sink" 2>/dev/null | awk '{ printf "%d", $2 * 100 + 0.5 }'; }
is_muted() { wpctl get-volume "$sink" 2>/dev/null | grep -q MUTED; }
set_volume() { wpctl set-volume "$sink" "$1%" 2>/dev/null; }
set_mute() { wpctl set-mute "$sink" "$1" 2>/dev/null; }

cur=$(current)
case "$cur" in
    ''|*[!0-9]*)
        notify-send -u critical 'Volume' 'No audio server'
        exit 1
        ;;
esac

case "$1" in
    up)
        new=$((cur + step))
        [ "$new" -gt 100 ] && new=100
        set_mute 0
        set_volume "$new"
        ;;
    down)
        new=$((cur - step))
        [ "$new" -lt 0 ] && new=0
        set_volume "$new"
        ;;
    mute)
        set_mute toggle
        ;;
    *)
        echo "usage: volume up|down|mute" >&2
        exit 1
        ;;
esac

if is_muted; then
    notify-send 'Volume' "$(slider 0) muted"
else
    vol=$(current)
    notify-send 'Volume' "$(slider "$vol") $vol%"
fi
